-------------------------------------------------------------------------------
-- GNAT Project File for Poker Solitaire
-- Build with: gprbuild -P poker_solitaire.gpr
-------------------------------------------------------------------------------

project Poker_Solitaire is

   -- Source and object directories
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   -- Main program
   for Main use ("poker_solitaire.adb");

   -- Compiler options
   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2012",     -- Use Ada 2012 standard
         "-gnatwa",       -- Enable all warnings
         "-gnatVa",       -- Enable all validity checks
         "-gnato",        -- Enable overflow checks
         "-fstack-check", -- Enable stack checking
         "-g"             -- Generate debug info
      );
   end Compiler;

   -- Binder options
   package Binder is
      for Default_Switches ("Ada") use ("-E");  -- Store tracebacks in exceptions
   end Binder;

   -- Linker options
   package Linker is
      for Default_Switches ("Ada") use ("-g");
   end Linker;

   -- Builder options
   package Builder is
      for Executable ("poker_solitaire.adb") use "poker_solitaire";
   end Builder;

end Poker_Solitaire;
